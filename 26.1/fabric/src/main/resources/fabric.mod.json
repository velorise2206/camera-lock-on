  },
  "license": "All Rights Reserved",
  "icon": "logo.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.velorise.cameralockon.CameraLockOn"
    ]
  },
  "mixins": [
    "camera_lockon.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.2",
    "minecraft": "~26.1",
    "java": ">=25",
    "fabric-api": "*"
  }
